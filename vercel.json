{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @inventienda/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://inventienda-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
