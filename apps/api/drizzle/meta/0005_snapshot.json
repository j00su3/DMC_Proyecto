      "checkConstraints": {
        "movimientos_signo_tipo": {
          "name": "movimientos_signo_tipo",
          "value": "(\n        (\"movimientos\".\"tipo\" = 'entrada'::movimiento_tipo AND \"movimientos\".\"cantidad\" > 0) OR\n        (\"movimientos\".\"tipo\" IN ('salida'::movimiento_tipo, 'venta'::movimiento_tipo) AND \"movimientos\".\"cantidad\" < 0) OR\n        (\"movimientos\".\"tipo\" = 'anulacion'::movimiento_tipo AND \"movimientos\".\"cantidad\" > 0) OR\n        (\"movimientos\".\"tipo\" = 'ajuste'::movimiento_tipo)\n      )"
        },
        "movimientos_discrepancia_solo_ajuste": {
          "name": "movimientos_discrepancia_solo_ajuste",
          "value": "\"movimientos\".\"es_discrepancia\" = false OR \"movimientos\".\"tipo\" = 'ajuste'::movimiento_tipo"
        },
        "movimientos_merma_solo_salida": {
          "name": "movimientos_merma_solo_salida",
          "value": "\"movimientos\".\"es_merma\" = false OR \"movimientos\".\"tipo\" = 'salida'::movimiento_tipo"
        },
        "movimientos_ajuste_cantidad_no_cero": {
          "name": "movimientos_ajuste_cantidad_no_cero",
          "value": "\"movimientos\".\"tipo\" <> 'ajuste'::movimiento_tipo OR \"movimientos\".\"cantidad\" <> 0"
        }
      },
